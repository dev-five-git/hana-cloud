{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dev-five-git/hana-registry/main/schemas/normalization-examples.schema.json",
  "title": "Hana Normalization Contract Examples",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "descriptorStrings", "usbHex"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "descriptorStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inputs", "normalized"],
        "properties": {
          "inputs": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "normalized": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^(?!-)(?!.*--)(?!.*[\\s_])(?!.*-$).+$"
          }
        }
      }
    },
    "usbHex": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "normalized"],
        "properties": {
          "input": { "type": "string", "minLength": 1 },
          "normalized": { "type": "string", "pattern": "^[0-9a-f]{4}$" }
        }
      }
    }
  }
}
