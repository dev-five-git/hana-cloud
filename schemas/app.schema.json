{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dev-five-git/hana-registry/main/schemas/app.schema.json",
  "title": "Hana Application Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "actions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "shortcut": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:cmd|command|meta|super|ctrl|control|alt|option|shift)\\+)*(?:pagedown|pgdn|pageup|pgup|home|end|up|down|left|right|space|enter|return|tab|escape|esc|mediaplaypause|playpause|medianexttrack|nexttrack|mediaprevtrack|prevtrack|volumeup|volumedown|volumemute|mute|[a-z0-9])$"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "name", "shortcut"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 20 },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "shortcut": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 3,
          "properties": {
            "macos": { "$ref": "#/$defs/shortcut" },
            "windows": { "$ref": "#/$defs/shortcut" },
            "linux": { "$ref": "#/$defs/shortcut" }
          }
        }
      }
    }
  }
}
